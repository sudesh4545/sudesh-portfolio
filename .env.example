# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put private API keys / secrets here — anything in a VITE_ variable is
# publicly readable in the built JavaScript. Use provider endpoints that are
# safe to expose (Formspree form URLs, EmailJS public keys, your own backend).
# ---------------------------------------------------------------------------

# Contact form endpoint. The form POSTs JSON here.
# Works out of the box with Formspree: https://formspree.io/f/xxxxxxx
# Or point it at your own backend route (e.g. /api/contact) or a Resend proxy.
# If this is left empty the form validates + tells the visitor it is not
# connected yet and offers a mailto fallback — it never fakes a success state.
VITE_CONTACT_ENDPOINT=

# Public site URL. Substituted into index.html as %SITE_URL% at build time and
# used for the canonical link, the Open Graph URL and the schema.org profile.
# No trailing slash.
VITE_SITE_URL=https://your-domain.com
